# Drift environment — copy to .env and fill in what you have.
# Everything degrades gracefully: no GEMINI_API_KEY -> run with --fixtures;
# no Guild keys (or DIRECT_POST=1) -> comments post directly via gh.

# Gemini key (Scribe extraction + Historian judge). May be absent — fixtures mode runs without it.
GEMINI_API_KEY=

# GitHub repo that seed.py creates issues in and the Herald comments on.
DRIFT_REPO=sharique2004/mmm-demo

# 1 = skip Guild, post comments directly via gh.
DIRECT_POST=0

# Guild.ai API trigger credentials (web UI: Triggers -> New -> API) + workspace coords.
GUILD_KEY_ID=
GUILD_KEY_SECRET=
GUILD_OWNER=
GUILD_WORKSPACE=

# FalkorDB (local container falkordb-test; browser UI at http://localhost:3000).
FALKOR_HOST=localhost
FALKOR_PORT=6379
GRAPH_NAME=drift
