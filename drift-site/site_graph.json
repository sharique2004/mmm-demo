"props": {
"number": 4,
"repo": "sharique2004/mmm-demo",
"title": "Rate-limit the public API",
"slug": "ratelimit"
}
},
{
"id": 4,
"label": "Person",
"props": {
"name": "Marco"
}
},
{
"id": 5,
"label": "Meeting",
"props": {
"id": "m1",
"title": "Project Kickoff",
"date": "2026-07-28"
}
},
{
"id": 6,
"label": "Statement",
"props": {
"segment_id": "m1-s06",
"text": "Migrate the auth service to OAuth2 using Auth0; Marco owns the migration; target Aug 20",
"kind": "decision",
"ts": "00:03:42"
}
},
{
"id": 7,
"label": "Person",
"props": {
"name": "Priya"
}
},
{
"id": 8,
"label": "Statement",
"props": {
"segment_id": "m1-s09",
"text": "Use a Redis cache for transcript ingestion; Sam owns it; target Aug 10",
"kind": "decision",
"ts": "00:06:47"
}
},
{
"id": 9,
"label": "Person",
"props": {
"name": "Chen"
}
},
{
"id": 10,
"label": "Statement",
"props": {
"segment_id": "m1-s13",
"text": "Chen is drafting the offline mode spec this week and will bring it to the team for review before any build work starts",
"kind": "update",
"ts": "00:09:38"
}
},
{
"id": 11,
"label": "Person",
"props": {
"name": "Sam"
}
},
{
"id": 12,
"label": "Meeting",
"props": {
"id": "m2",
"title": "Eng Standup",
"date": "2026-07-31"
}
},
{
"id": 13,
"label": "Statement",
"props": {
"segment_id": "m2-s02",
"text": "Sam is benchmarking the Redis cache against replayed ingestion traffic with roughly 40 percent lower lookup latency; on track for Aug 10",
"kind": "update",
"ts": "00:00:26"
}
},
{
"id": 14,
"label": "Statement",
"props": {
"segment_id": "m2-s05",
"text": "Auth0 tenant is set up, dev environment authenticates end to end, claims-to-scopes mapping underway; still tracking Aug 20",
"kind": "update",
"ts": "00:02:05"
}
},
{
"id": 15,
"label": "Statement",
"props": {
"segment_id": "m2-s08",
"text": "Chen asks whether public API rate limits will be per-key or per-org, since it affects mobile retry logic",
"kind": "question",
"ts": "00:03:58"
}
},
{
"id": 16,
"label": "Meeting",
"props": {
"id": "m3",
"title": "Sprint Planning",
"date": "2026-08-03"
}
},
{
"id": 17,
"label": "Statement",
"props": {
"segment_id": "m3-s05",
"text": "Switch the cache layer from Redis to an in-memory LRU; Priya takes ownership from Sam; new target Aug 14",
"kind": "decision",
"ts": "00:02:10"
}
},
{
"id": 18,
"label": "Statement",
"props": {
"segment_id": "m3-s09",
"text": "Drop Auth0 for the OAuth2 migration and switch to Clerk; cutover target moves to Sept 1",
"kind": "decision",
"ts": "00:03:56"
}
},
{
"id": 19,
"label": "Statement",
"props": {
"segment_id": "m3-s13",
"text": "The offline mode spec Chen drafted is approved as written; build starts next sprint with Chen leading, unchanged from the kickoff plan",
"kind": "decision",
"ts": "00:06:52"
}
}
],
